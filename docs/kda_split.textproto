name: "kda-directml-native"
data_loader {
  stage {
    name: "file_path_provider"
    file_path_provider {
      # Fishtest supervised set: 2,002,208 games converted with
      # -pgn-eval-mode -wdl-scale 1.3 -visit-budget 850, then rescored
      # against 3-4-5 Syzygy. One game per chunk, 6,000 per directory
      # across 334 of them (fishtest-see-0 .. fishtest-see-333, the last
      # holding 4,208) -- matching the -chunks-per-dir 6000 used at
      # conversion. The provider recurses, and the loader maps .gz to
      # RawFileChunkSource and .tar to TarChunkSource, so both work from
      # the same directory setting.
      #
      # The same corpus exists in two shapes, and either can be used here:
      #   .../Fishtest-SEE        loose .gz in 334 subdirectories
      #   .../Fishtest-SEE-tars   the same games packed as 334 .tar (50 GB)
      #
      # Counts corrected 2026-08-25. This comment previously read "1,393,183
      # games ... 5,000 files per subdirectory across 285" -- none of which
      # matched the corpus on disk, and chunk_pool_size below had been sized
      # from those wrong numbers. Verify against the corpus's convert.log
      # rather than this comment if they ever disagree again.
      #
      # Previous corpus (345 tars, 89 GB) if you want to switch back:
      # directory: "C:/Users/Contrad/Documents/training-data/k2hybrid-bt4tf13g-v7op1"
      # directory: "C:/Users/Contrad/Documents/training-data/fishtest-archives"
	  directory: "C:/Users/Contrad/Documents/training-data/Fishtest-SEE-tars"
      output {
        queue_capacity: 16
      }
    }
  }
  stage {
    name: "chunk_source_loader"
    input: "file_path_provider"
    chunk_source_loader {
      # This one number is almost the whole startup cost. Indexing the 345
      # tars means reading headers across an 89 GB corpus, and at threads: 1
      # it ran strictly sequentially at ~1.2 s per tar. Measured to the first
      # batch, loader only, no trainer:
      #
      #   threads: 1   460 s
      #   threads: 4   117 s
      #   threads: 6    97 s
      #
      # 4, not 6: the machine has 4 physical cores, and the runs were timed
      # in the order 4, 1, 6, so 6 had the warmest file cache and 4 the
      # coldest -- the 4-vs-1 gap is if anything understated and 6's edge
      # over 4 is flattered. The threads idle on the input queue once the
      # initial scan is done, so this costs nothing during training.
      #
      # Worth raising ONLY here. The per-stage threads below feed a trainer
      # that is GPU-bound at ~880 ms/step, so more of them buys no
      # throughput, and shuffling_frame_sampler.reservoir_size_per_thread
      # means extra sampler threads cost host memory outright.
      threads: 4
      output {
        queue_capacity: 16
      }
       #frame_format: V7TrainingData
       frame_format: V6TrainingData
    }
  }
  stage {
    name: "chunk_source_splitter"
    input: "chunk_source_loader"
    chunk_source_splitter {
      output {
        name: "train"
        queue_capacity: 16
      }
      output {
        name: "test"
        queue_capacity: 1
      }
      weight: 99
      weight: 1
    }
  }
  stage {
    name: "train_shuffling_chunk_pool"
    input: "chunk_source_splitter.train"
    shuffling_chunk_pool {
      # Sampling WINDOW, not a buffer: the pool draws from the last
      # chunk_pool_size chunks it has seen, so anything smaller than the
      # corpus silently trains on a slice of it. It must also stay ABOVE
      # the total, because the indexing loop breaks once it has enough and
      # then discards the sources it never reached -- oldest first, with no
      # error.
      #
      # 3,600,000 covers the full 345-tar corpus (~3,445,000 chunks) with
      # room for a few more drops. Drop it to 1,760,000 only while the
      # corpus is cut back to the 175-tar set -- and never leave it below
      # the tar count times 10,000, or the loop above silently trims.
      #
      # With --data-file-count this cap only has to exceed the window, so
      # an oversized value stays correct there too.
      #
      # 2,004,000 for the Fishtest-SEE set. The authoritative count is in
      # the corpus's own convert.log: "All inputs done: 2002208 chunk files
      # written in total", which cross-checks against the layout exactly --
      # 333 full directories x 6,000 games + 4,208 in fishtest-see-333 =
      # 2,002,208. This leaves 1,792 of headroom; re-derive it from
      # convert.log if the corpus is ever extended.
      #
      # Corrected 2026-08-25 from 1,450,000. That value was computed from a
      # stale premise -- it assumed 1,393,183 games, and the directory
      # comment above still described a corpus that no longer matches what
      # is on disk. The real corpus is ~44% larger, so the pool sat roughly
      # 552,000 chunks BELOW the total and was silently dropping ~28% of it,
      # oldest-first, with no error: precisely the trimming failure the note
      # at the top of this block warns about.
      chunk_pool_size:  2004000
      source_ingestion_threads: 1
      chunk_loading_threads: 4
      output {
        queue_capacity: 8
      }
    }
  }
  # train_chunk_rescorer removed 2026-08-25. It bundled three things:
  #   - Syzygy relabelling: near-zero effect on this corpus (Fishtest games
  #     are adjudicated around +4 pawns, long before any position is
  #     tablebase-reachable -- a full-corpus rescore only relabelled ~0.02%
  #     of games).
  #   - V6->V7 upgrade (q_st/d_st + lookahead played-move indices): currently
  #     unread, since losses{} below wires no value/value_error/
  #     value_categorical loss to head_name "st" -- nothing consumes those
  #     fields yet.
  #   - Deblunder (deblunder_threshold: 0.1, deblunder_width: 0.06): this
  #     part WAS doing real, active work independent of the above two --
  #     RescorerDeblunderSetup() walks each game backwards and swaps the
  #     training target away from raw searched Q toward the actual result
  #     once a played move is far enough below the best move's Q. Dropping
  #     the stage drops this too; deliberate trade for pipeline throughput.
  # To restore: re-add the stage between train_shuffling_chunk_pool and
  # train_chunk_unpacker with input/output wired as they were, and point
  # train_chunk_unpacker.input back at it.
  #
  # stage {
  #   name: "train_chunk_rescorer"
  #   input: "train_shuffling_chunk_pool"
  #   chunk_rescorer {
  #     threads: 1
  #     output {
  #       queue_capacity: 4
  #     }
  #     syzygy_paths: "C:/Users/Contrad/Documents/syzygy/3-4-5"
  #     dist_temp: 1.0
  #     dist_offset: 0.0
  #     dtz_boost: 0.0
  #     new_input_format: -1
  #     deblunder_threshold: 0.1
  #     deblunder_width: 0.06
  #   }
  # }
  stage {
    name: "train_chunk_unpacker"
    input: "train_shuffling_chunk_pool"
    chunk_unpacker {
      threads: 1
      # ---------------------------------------------------------------
      # TACTICAL SAMPLING -- draft, not enabled.
      #
      # Aims at the gap where Stockfish's handcrafted evaluation sees what
      # a policy/value net does not: sacrifices played for a concrete
      # follow-up, and queen endgames decided by forcing sequences.
      #
      # PREREQUISITE: src/proto/data_loader_config_pb2.py must be
      # regenerated first (six new fields), with a protoc matching the
      # training environment's protobuf runtime. Python parses this file
      # before handing it to C++, so until then text_format.Parse rejects
      # these as unknown fields and the trainer will not start. The C++
      # side is already written and compiles.
      #
      # To enable: comment out position_sampling_rate below, uncomment
      # this.
      #
      position_count: 66
      position_sampling {
        material_sacrifice_weight: 1.0
        endgame_focus_weight: 3.0
        endgame_require_queens: true
        endgame_material_max: 40.0
        diff_focus_alpha: 1.5
        diff_focus_beta: 0.2
        diff_focus_tau: 2.0
      }
      #
      # WHY THESE NUMBERS
      #
      # Tuned to put queen endgames at 20% of sampled positions, measured
      # by replaying the real weight formula over 1,500 games rather than
      # estimated. Result: 20.1% queen endgame, with sacrifice and endgame
      # positions weighted EQUALLY at 1.32 against 0.20 for a quiet
      # position -- a 6.6x boost for both.
      #
      # position_count 66 matches what rate 0.5 draws today: the corpus
      # sweep measured ~130 interior positions per game.
      #
      # endgame_material_max 40, NOT 30, is what makes 20% reachable at
      # all. Weights are normalised per game, so a game that never reaches
      # a queen endgame contributes none no matter how hard the term is
      # pushed -- the fraction of games that reach one is a hard ceiling.
      # Measured:
      #
      #   material_max 30 -> only 30.3% of games qualify. Hitting 20%
      #                      needs a ~100x within-game ratio, which makes
      #                      those games sample almost nothing BUT endgame
      #                      positions and destroys their middlegame
      #                      coverage.
      #   material_max 40 -> 54.3% of games qualify, and 20% falls out at
      #                      a mild ratio with room to spare.
      #
      # 40 is also the better definition on its own terms: the starting
      # position holds 78 points of material, so this is "queens still on,
      # most minor pieces traded" rather than the very deep ending 30
      # describes.
      #
      # The 1.0 / 3.0 split keeps the two terms comparable, and it is the
      # one thing here that is easy to get wrong: they are NOT on the same
      # scale. The sacrifice signal is material in pawns (a piece is ~3, a
      # queen ~9), while the endgame term is a 0/1 indicator. Left equal,
      # material would swamp phase entirely. At 1:3 both land on 1.32.
      #
      # diff_focus_beta 0.2 is a FLOOR and is load-bearing. Weights are
      # normalised by the per-game maximum, then SampleProbabilisticSequence
      # accepts each candidate with that probability, reshuffling until it
      # has position_count of them. With no floor a quiet position scores
      # exactly 0.0, is never accepted, and a game containing one sacrifice
      # would train on that sacrifice and nothing else. It also bounds the
      # reshuffle loop, which matters on a threads: 1 unpacker -- these
      # values leave a worst-case acceptance of 10.2%.
      #
      # diff_focus_alpha 1.5 rather than a larger endgame_focus_weight is
      # what actually buys the last few points of queen endgame share.
      # Raising endgame_focus_weight saturates against tau and stops
      # helping: 3.0 -> 10.0 moved the result only from 17.7% to 19.5%,
      # while also unbalancing the sacrifice term. Scaling the whole mean
      # lifts both signals together instead.
      #
      # diff_focus_tau 2.0 raises the ceiling from its 1.0 default, which
      # would otherwise saturate everything above ~0.7 and erase the
      # distinction between a quiet endgame, a sacrifice, and a sacrifice
      # inside an endgame.
      #
            # temporal_curvature_weight is deliberately NOT set. It is
      # implemented and available, but measurement showed it does not do
      # what it looks like it does -- see the note below.
      #
      # WHY NOT SELECT ON THE EVALUATION
      #
      # Every eval-derived tactic detector tried here failed, for one
      # structural reason: Stockfish's evaluation is steadiest exactly
      # where its understanding is deepest. It does not wobble through a
      # sound sacrifice, because it saw the compensation before playing
      # it. Measured on this corpus:
      #
      #   - Compensation positions land in the top curvature decile 13.5%
      #     of the time, against 10% by chance. Curvature does not find
      #     sacrifices.
      #   - Queen endgames have the LOWEST median per-ply eval movement of
      #     any phase (0.0047 against 0.0302 overall). Volatility does not
      #     find tactical endgames either.
      #
      # Both terms configured above therefore read the BOARD -- material
      # configuration and material events from the plane bitboards -- and
      # never the evaluation.
      #
      # Relatedly, material_sacrifice_weight selects on the EVENT (material
      # was given up) and not on the OUTCOME (it turned out well). A
      # result-based rule silently drops unsound sacrifices, because there
      # material and evaluation agree, and a model trained only on
      # sacrifices that worked learns that sacrificing wins. The event rule
      # measures 44% winning / 38% losing, so both classes are present and
      # the model has to learn what separates them.
      #
      # TWO THINGS TO KNOW BEFORE FLIPPING IT ON
      #
      # 1. Coverage. position_count mode abandons rate mode's guarantee.
      #    PickSampledPositions partitions a game into disjoint subsets, so
      #    over 1/rate uses every position is emitted exactly once.
      #    SampleProbabilisticSequence draws from an infinite weighted
      #    sequence with no coverage guarantee and no dedupe. That is the
      #    point of weighting, but the training distribution changes, not
      #    just the ordering.
      #
      # 2. This is a mid-run distribution change. The run is past step
      #    437k on uniform sampling; switching now means loss curves before
      #    and after are not measuring the same thing. Worth starting from
      #    a checkpoint and comparing against a uniform control rather than
      #    reading the existing curve straight through.
      #
      # Deliberately left OFF on test_chunk_unpacker below, so the eval
      # metric keeps measuring a uniform sample and stays comparable
      # against every checkpoint recorded before this change.
      # ---------------------------------------------------------------
      # position_sampling_rate: 0.5   # superseded by position_count above
      output {
        queue_capacity: 16
      }
    }
  }
  stage {
    name: "train_shuffling_frame_sampler"
    input: "train_chunk_unpacker"
    shuffling_frame_sampler {
      threads: 1
      reservoir_size_per_thread: 5000
      output {
        queue_capacity: 16
      }
    }
  }
  stage {
    name: "train_tensor_generator"
    input: "train_shuffling_frame_sampler"
    tensor_generator {
      threads: 2
      batch_size: 8
      output {
        queue_capacity: 4
      }
    }
  }
  stage {
    name: "test_shuffling_chunk_pool"
    input: "chunk_source_splitter.test"
    shuffling_chunk_pool {
      # A ceiling, not a matched cap. The splitter weights route only 1%
      # of chunks here (~20,000 of 2,002,208), so any value comfortably
      # above that is equivalent; this one is left oversized on purpose so
      # it never becomes the limiting factor. Unlike the train pool it does
      # not need re-deriving when the corpus grows.
      chunk_pool_size: 3600000
      source_ingestion_threads: 1
      chunk_loading_threads: 4
      output {
        queue_capacity: 16
      }
    }
  }
  # test_chunk_rescorer removed 2026-08-25, same reasoning as
  # train_chunk_rescorer above -- kept in sync so test-set positions go
  # through the same pipeline as train, not a different label source for
  # the eval metric.
  #
  # stage {
  #   name: "test_chunk_rescorer"
  #   input: "test_shuffling_chunk_pool"
  #   chunk_rescorer {
  #     threads: 1
  #     output {
  #       queue_capacity: 16
  #     }
  #     syzygy_paths: "C:/Users/Contrad/Documents/syzygy/3-4-5"
  #     dist_temp: 1.0
  #     dist_offset: 0.0
  #     dtz_boost: 0.0
  #     new_input_format: -1
  #     deblunder_threshold: 0.1
  #     deblunder_width: 0.06
  #   }
  # }
  stage {
    name: "test_chunk_unpacker"
    input: "test_shuffling_chunk_pool"
    chunk_unpacker {
      threads: 1
      position_sampling_rate: 0.5
      output {
        queue_capacity: 16
      }
    }
  }
  stage {
    name: "test_shuffling_frame_sampler"
    input: "test_chunk_unpacker"
    shuffling_frame_sampler {
      threads: 1
      # Smaller than the train reservoir on purpose: this one only feeds
      # --eval-batches batches every --eval-every steps, so a large one is
      # host memory held idle almost all of the time.
      reservoir_size_per_thread: 1000
      output {
        queue_capacity: 16
      }
    }
  }
  stage {
    name: "test_tensor_generator"
    input: "test_shuffling_frame_sampler"
    tensor_generator {
      threads: 1
      batch_size: 32
      output {
        queue_capacity: 8
      }
    }
  }
  output: "train:train_tensor_generator"
  output: "test:test_tensor_generator"
}
training {
  schedule {
    steps_per_network: 1000
    chunks_per_network: 5000
  }
  lr_schedule {
    starting_step: 464835
    duration_steps: [50000, 0]
    lr: [0.0009, 0.0001]
    transition: [COSINE, CONSTANT]
  }
  checkpoint {
    path: "C:/Users/Contrad/Documents/lc0-directml-checkpoint"
    max_to_keep: 10
  }
  optimizer {
    nadamw {
      beta_1: 0.9
      beta_2: 0.98
      epsilon: 1e-07
      weight_decay: 0.0001
      decay_selector {
        rule {
          match: "**/bias"
        }
        rule {
          match: "**/ln*/**"
        }
        rule {
          match: "**/embedding/embedding/**"
        }
        rule {
          match: "**/policy_heads/**"
          include: true
        }
        rule {
          match: "**/value_heads/**"
          include: true
        }
        rule {
          match: "**/movesleft_heads/**"
          include: true
        }
      }
    }
  }
  losses {
    policy {
      head_name: "vanilla"
      metric_name: "main_ce"
      weight: 1.0
      illegal_moves: MASK
      type: CROSS_ENTROPY
      #temperature: 2.0   # <--- Set higher PST here (e.g. 1.5, 2.0, or 2.5)
    }
    value {
      head_name: "winner"
      weight: 0.5
    }
    movesleft {
      head_name: "main"
      weight: 0.5
    }
  }
  # 8.0, down from 16.0. Steady-state gradient norm here is ~5-6 and a
  # survivable spike to 11 was seen, so 8 leaves normal steps untouched while
  # firmly catching the larger spikes that 16 let through -- one of which
  # overflowed to NaN on the next step and stalled training in the 212k-224k
  # region for a full day. Deliberately not lower: 4 would clip most normal
  # steps and quietly slow learning. Not part of the checkpoint digest, so it
  # is safe to change mid-run. Pair it with --nan-check skip, which drops any
  # gradient that is already non-finite before the clip can see it.
  max_grad_norm: 8.0
  # Batch 32 is the hard memory ceiling for this model on the Iris Xe (48
  # already OOMs), so the effective batch is bought with accumulation
  # instead, at the peak memory of a single 32.
  #
  # 4, not 8: a first attempt at 8 ran 47 steps and then died with a host
  # OOM. This machine has 11.7 GB shared with the iGPU and roughly 4.5 GB
  # free at rest, so headroom is thin. Raise it once a run has been stable
  # for a few thousand steps -- the effective batch is this times
  # tensor_generator.batch_size.
  #
  # Do NOT set this to 1 on DirectML. Peak *activation* memory really is
  # accumulation-neutral, but peak process memory is not, and the difference
  # decides whether a run lives:
  #
  #   accumulation 4: RSS plateaus at 4.63 GB and the run continues
  #   accumulation 1: RSS passes 5.9 GB inside 90 s and the run dies
  #
  # Measured three times over, each launch starting with 5.6-5.7 GB free --
  # so this is not other processes competing, and closing things does not
  # help. The mechanism is churn, not peak: NAdamW's update allocates about
  # ten short-lived temporaries per parameter, DirectML strands a heap for
  # many of them, and accumulation is the one lever that runs optimizer.step()
  # LESS often per unit of data. At 1 it runs 4x as often and the stranding
  # outruns the headroom. Fixing the optimizer to reuse buffers would remove
  # the constraint; until then 4 is load-bearing.
  gradient_accumulation_steps: 8
}
model {
  defaults {
    compute_dtype: F32
    activation: ACTIVATION_MISH
    ffn_activation: ACTIVATION_MISH
  }
  embedding {
    dense_size: 64
    embedding_size: 128
    dff: 128
  }
  encoder {
    num_blocks: 4
    dff: 256
    d_model: 128
    heads: 16
    smolgen {
      hidden_channels: 8
      hidden_size: 32
      gen_size: 32
      activation: ACTIVATION_SWISH
    }
    kda {
      key_dim: 32
      value_dim: 32
      gate_rank: 32
      directions: "rank_forward"
      directions: "rank_reverse"
      directions: "file_forward"
      directions: "file_reverse"
      directions: "diag_forward"
      directions: "diag_reverse"
      directions: "anti_diag_forward"
      directions: "anti_diag_reverse"
      output_gate: true
      output_rms_norm: false
      local_conv: false
    }
    mixer_pattern: MIXER_KDA
    mixer_pattern: MIXER_KDA
    mixer_pattern: MIXER_KDA
    mixer_pattern: MIXER_MHA
  }
  shared_policy_embedding_size: 128
  policy_head {
    name: "vanilla"
    d_model: 128
    use_bias: false
  }
  value_head {
    name: "winner"
    num_channels: 64
  }
  value_head {
    name: "q"
    num_channels: 64
    has_error_output: true
    num_categorical_buckets: 16
  }
  value_head {
    name: "st"
    num_channels: 64
    has_error_output: true
    num_categorical_buckets: 16
  }
  movesleft_head {
    name: "main"
    num_channels: 32
  }
}
metrics {
  tensorboard_path: "C:/Users/Contrad/Documents/lc0-directml-tensorboard/kda-directml-native-train"
}
export {
  destination_filename: "C:/Users/Contrad/Documents/lc0-directml-networks/kda-native-{step}.pb.gz"
}
