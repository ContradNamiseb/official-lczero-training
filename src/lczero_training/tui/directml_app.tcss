/* Dense widget-dashboard layout. One border per panel, no outer frame --
   an outer full-screen border would be a second nesting level that buys
   nothing. Titles live in the border, which is free vertical space. */

Screen {
    layout: vertical;
    background: $surface;
}

/* Panels size to their content; the log takes whatever is left, so the
   dashboard never grows a dead region when the terminal is tall. */
#header {
    height: 3;
    border: round $primary;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
}

#row-top {
    height: 8;
}

#row-mid {
    height: 8;
}

#row-top > Static,
#row-mid > Static {
    width: 1fr;
    /* Static defaults to height: auto, sized off whatever render_panel()
       returns at the moment of first layout -- almost always the
       one-line "no data yet" placeholder, since the daemon hasn't sent a
       single step yet when compose() runs. Widget.refresh() (used on
       every metrics update, see directml_app.py's _ingest_metrics) does
       NOT re-layout by default, only repaints, so an auto-sized panel
       never grows past that first frame: real, multi-row tables get
       clipped down to their header. 1fr fills the row's fixed height
       (see #row-top/#row-mid above) up front, independent of content, so
       there is nothing left to freeze.
    */
    height: 1fr;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    padding: 0 1;
}

StreamingLogPane {
    height: 1fr;
    min-height: 4;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    padding: 0 1;
}

Footer {
    height: 1;
}

/* Narrow (<90 cols): the two-up rows stack. Costs height, keeps every
   value readable rather than truncating labels. */
Screen.narrow #row-top,
Screen.narrow #row-mid {
    layout: vertical;
    height: auto;
}

Screen.narrow #row-top > Static,
Screen.narrow #row-mid > Static {
    width: 100%;
    /* 6, not 7: border takes 2, leaving exactly the 4 content rows both
       panels need (kda is a header plus three blocks). Stacked panels are
       paid for twice over, so the extra row is the difference between
       fitting on a 16-row terminal and pushing kda off the bottom. */
    height: 6;
}

/* No room for the log once the panels have stacked. Losing scrollback is
   better than losing a panel: the log is also on disk via --logfile. */
Screen.no-log StreamingLogPane {
    display: none;
}

/* Short (<30 rows): drop the policy/optimizer row. Losses and KDA health
   are what you watch continuously; the rest is available in TensorBoard.
   Without this, 80x24 pushes the log and footer off the bottom. */
Screen.short #row-mid {
    display: none;
}

/* Below the floor, say so rather than render a broken grid. */
Screen.too-small #row-top,
Screen.too-small #row-mid,
Screen.too-small StreamingLogPane {
    display: none;
}

/* The notice is the inverse: present only below the floor. */
#too-small-notice {
    display: none;
}

Screen.too-small #too-small-notice {
    display: block;
    height: 1fr;
    content-align: center middle;
    color: $warning;
}
