*.sage.py

# Environments
.env
.venv
# Every venv variant, not just ".venv". The DirectML environment is
# .venv-directml, which no rule here matched -- it was ignored only because
# uv writes a .gitignore containing "*" inside each venv it creates. That
# works until the file goes missing, at which point three gigabytes of
# site-packages are offered up for commit.
.venv*/
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# protobuf stuff
tf/proto/
**/*_pb2.py
**/*_pb2.pyi

# Meson
builddir/
subprojects/
# ...except the wraps and packagefiles, which the build needs from a fresh
# clone. zlib in particular is required by the native Windows MSVC build.
!subprojects/*.wrap
!subprojects/packagefiles/

# Training run artifacts
*.log
daemon-io.jsonl
# The headless supervisor parks the daemon's JSONL protocol stream in a .out
# file, since with no TUI attached stdout is noise.
*.out
# Checkpoints, exported networks, and the eval worker's batch dumps. These
# normally live outside the repo, but a run started with a relative --output
# or a hand-run eval would drop them here.
*.pt
*.pb.gz
*.npz

# LLM Agents
# Use AGENTS.md; symlink other files to it if needed.
.claude/
CLAUDE.local.md
.claude.json
CLAUDE.md
GEMINI.md

# IDE
.vscode/
.idea/